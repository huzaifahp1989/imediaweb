# Copy this file to `.env` (for local dev) and set real values.
# Vite loads `.env` / `.env.local` at startup. Restart the dev server after changes.

# Supabase project configuration
VITE_SUPABASE_URL=https://pmxahrmjxbfzuyqeoraz.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

VITE_QURAN_API_TOKEN=YOUR_QURAN_API_TOKEN
VITE_QURAN_API_CLIENT_ID=YOUR_QURAN_API_CLIENT_ID

# Deployment notes (Vercel)
# - These VITE_* variables must be set in Vercel → Project → Settings → Environment Variables.
# - After adding/updating env vars, trigger a fresh deploy.
# - In Supabase → Authentication, add your production domain to Redirect URLs.
# - Enable Email/Password sign-in and create your admin user.
# - Local API testing: run `npx vercel dev` (serves /api/* + Vite app).

# Use Vercel API routes for messages (optional)
# Set to true to route message operations through serverless functions
VITE_USE_BACKEND=false

# Admin gating (optional but recommended)
# Exact email used to sign in; required for AdminGuard to allow access
VITE_ADMIN_EMAIL=admin@example.com

# Simple 2FA gate for AdminLogin. For production, enable Firebase Multi-factor instead.
VITE_ADMIN_2FA_CODE=123456

# Setup notes
# In Supabase → Authentication: enable Email/Password and add your site domain to Redirect URLs.

# Vercel serverless API (server-side) configuration
# In Vercel → Project → Settings → Environment Variables
# SUPABASE_URL=https://pmxahrmjxbfzuyqeoraz.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Restrict functions to your admin email
# ADMIN_EMAIL=admin@example.com
# Optional: RESEND_API_KEY / SENDGRID_API_KEY, OPENAI_API_KEY, AZURE_TTS_*, FIREBASE_*
